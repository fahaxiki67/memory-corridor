{
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume|compact",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${ZCODE_PLUGIN_ROOT}/hooks/zcode_hook.py\" || py -3 \"${ZCODE_PLUGIN_ROOT}/hooks/zcode_hook.py\"",
            "timeoutMs": 15000,
            "statusMessage": "Restoring Memory Corridor working state"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${ZCODE_PLUGIN_ROOT}/hooks/zcode_hook.py\" || py -3 \"${ZCODE_PLUGIN_ROOT}/hooks/zcode_hook.py\"",
            "timeoutMs": 15000,
            "statusMessage": "Checking Memory Corridor completion gate"
          }
        ]
      }
    ]
  }
}
